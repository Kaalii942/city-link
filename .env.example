# CITY LINK Enterprise System - Production Environment Configuration Template
# COPY THIS FILE TO .env AND SET YOUR ACTUAL PRODUCTION CREDENTIALS

# Port for Express API Backend Server
PORT=5000
NODE_ENV=production

# Frontend Application Origin (Used for CORS Security in Production)
FRONTEND_URL=https://your-citylink-frontend.vercel.app

# Database Connection String
# PostgreSQL Cloud Example: postgresql://user:password@ep-example.region.aws.neon.tech/citylink_db?sslmode=require
# MS SQL Server Example: sqlserver://server-ip:1433;database=eipms;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true;
# SQLite Local Dev Example: file:./dev.db
DATABASE_URL="postgresql://username:password@cloud-db-host:5432/citylink_db?sslmode=require"

# JWT Security Secrets (MUST be at least 32 random secure characters in production)
JWT_SECRET="your_long_random_jwt_access_token_secret_key_32_chars"
JWT_REFRESH_SECRET="your_long_random_jwt_refresh_token_secret_key_32_chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Files and Database Backup Directory Locations
BACKUP_DIR="./backups"
UPLOAD_DIR="./uploads"

# API Logging Threshold (error, warn, info, debug)
LOG_LEVEL=info

# Frontend Client Build Configuration (Set in Vercel Dashboard for apps/frontend)
# VITE_API_URL=https://your-backend-api.onrender.com
