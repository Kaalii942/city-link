{
  "name": "citylink-desktop",
  "version": "1.0.0",
  "description": "CITY LINK (Engineering & Services) Enterprise System",
  "author": "CITY LINK (Engineering & Services)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "electronVersion": "29.1.0",
    "appId": "pk.com.citylink.app",
    "productName": "CITY LINK (Engineering & Services)",
    "directories": {
      "output": "../../release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CITY LINK (Engineering & Services)",
      "artifactName": "CITY LINK Setup 1.0.0.${ext}",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../../packages/database/prisma/dev.db",
        "to": "dev.db"
      }
    ]
  }
}
