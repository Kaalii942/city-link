datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userRoles    UserRole[]
  sessions     Session[]
  activityLogs ActivityLog[]
  createdPOs   PurchaseOrder[] @relation("POCreator")
  approvedPOs  PurchaseOrder[] @relation("POApprover")
  stockMoves   StockMovement[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.NVarChar(500)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  details     String?  @db.NVarChar(MAX)
  ipAddress   String?
  machineName String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("SubCategories")
  products    Product[]  @relation("ProductCategory")
  subProducts Product[]  @relation("ProductSubCategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id          String          @id @default(uuid())
  companyName String          @unique
  contactName String
  email       String
  phone       String
  address     String
  country     String
  website     String?
  ntn         String?
  gst         String?
  bankDetails String?         @db.NVarChar(MAX)
  products    Product[]
  pos         PurchaseOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Customer {
  id             String   @id @default(uuid())
  departmentName String?
  companyName    String
  contactPerson  String
  email          String
  phone          String
  address        String
  projects       String?  @db.NVarChar(MAX)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Warehouse {
  id          String          @id @default(uuid())
  name        String          @unique
  location    String
  code        String          @unique
  sections    Section[]
  products    Product[]
  sourceMoves StockMovement[] @relation("SourceWarehouse")
  destMoves   StockMovement[] @relation("DestWarehouse")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Section {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  racks       Rack[]
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, name])
}

model Rack {
  id        String    @id @default(uuid())
  name      String
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  shelves   Shelf[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sectionId, name])
}

model Shelf {
  id        String    @id @default(uuid())
  name      String
  rackId    String
  rack      Rack      @relation(fields: [rackId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([rackId, name])
}

model Product {
  id              String          @id @default(uuid())
  name            String
  partNumber      String          @unique
  serialNumber    String?
  description     String?         @db.NVarChar(MAX)
  brandId         String?
  brand           Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?       @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId   String?
  subCategory     Category?       @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  countryOfOrigin String?
  manufacturer    String?
  purchasePrice   Decimal         @db.Decimal(18, 2)
  sellingPrice    Decimal         @db.Decimal(18, 2)
  unit            String          @default("Pcs")
  quantity        Int             @default(0)
  warehouseId     String?
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sectionId       String?
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rackId          String?
  rack            Rack?           @relation(fields: [rackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shelfId         String?
  shelf           Shelf?          @relation(fields: [shelfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  barcode         String?         @unique
  qrCode          String?
  imagePath       String?
  status          String          @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  remarks         String?         @db.NVarChar(MAX)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]
  inquiryItems    InquiryItem[]
  quotationItems  QuotationItem[]
}

model PurchaseOrder {
  id             String         @id @default(uuid())
  poNumber       String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderDate      DateTime
  expectedDate   DateTime?
  status         String         @default("PENDING") // PENDING, APPROVED, REJECTED, ORDERED, COMPLETED
  paymentStatus  String         @default("UNPAID") // UNPAID, PARTIAL, PAID
  deliveryStatus String         @default("PENDING") // PENDING, SHIPPED, DELIVERED
  taxRate        Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(18, 2)
  discountRate   Decimal        @default(0.00) @db.Decimal(5, 2)
  discountAmount Decimal        @default(0.00) @db.Decimal(18, 2)
  subTotal       Decimal        @db.Decimal(18, 2)
  totalAmount    Decimal        @db.Decimal(18, 2)
  approvalLevel  Int            @default(1)
  remarks        String?        @db.NVarChar(MAX)
  createdById    String
  creator        User           @relation("POCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById   String?
  approver       User?          @relation("POApprover", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          PurchaseItem[]
  invoices       Invoice[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(18, 2)
  totalLineAmount Decimal       @db.Decimal(18, 2)
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  amount             Decimal       @db.Decimal(18, 2)
  fileAttachmentPath String?
  paymentDate        DateTime?
  status             String        @default("UNPAID") // UNPAID, PAID
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model StockMovement {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             String     // STOCK_IN, STOCK_OUT, TRANSFER, DAMAGE, RETURN, RESERVE
  quantity         Int
  sourceWarehouseId String?
  sourceWarehouse  Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destWarehouseId   String?
  destWarehouse    Warehouse? @relation("DestWarehouse", fields: [destWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referenceNo      String?
  remarks          String?    @db.NVarChar(MAX)
  createdById      String
  creator          User       @relation(fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
}

model Attachment {
  id            String   @id @default(uuid())
  name          String
  fileType      String
  filePath      String
  referenceType String   // PRODUCT, SUPPLIER, PURCHASE_ORDER, INVOICE
  referenceId   String
  createdAt     DateTime @default(now())
}

model SystemSetting {
  key         String  @id
  value       String  @db.NVarChar(MAX)
  description String?
}

model Inquiry {
  id              String        @id @default(uuid())
  inquiryNumber   String        @unique
  inquiryDate     DateTime
  customerName    String
  companyName     String
  departmentName  String?
  phone           String?
  email           String?
  address         String?
  referenceNumber String?
  subject         String?
  remarks         String?       @db.NVarChar(MAX)
  status          String        @default("PENDING") // PENDING, PROCESSING, QUOTED, CANCELLED, COMPLETED
  items           InquiryItem[]
  quotations      Quotation[]
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InquiryItem {
  id           String   @id @default(uuid())
  inquiryId    String
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  srNo         Int
  partNumber   String
  description  String?  @db.NVarChar(MAX)
  manufacturer String?
  quantity     Int
  unit         String   @default("Pcs")
  remarks      String?  @db.NVarChar(MAX)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Quotation {
  id              String             @id @default(uuid())
  quotationNumber String             @unique
  quotationDate   DateTime
  validityDate    DateTime?
  inquiryId       String?
  inquiry         Inquiry?           @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customerId      String?
  companyName     String
  departmentName  String?
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  referenceNumber String?
  currency        String             @default("PKR")
  exchangeRate    Decimal            @default(1.00) @db.Decimal(18, 4)
  paymentTerms    String?
  deliveryTime    String?
  warranty        String?
  remarks         String?            @db.NVarChar(MAX)
  status          String             @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED, EXPIRED
  taxRate         Decimal            @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal            @default(0.00) @db.Decimal(18, 2)
  discountRate    Decimal            @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal            @default(0.00) @db.Decimal(18, 2)
  subTotal        Decimal            @db.Decimal(18, 2)
  totalAmount     Decimal            @db.Decimal(18, 2)
  preparedById    String?
  approvedById    String?
  items           QuotationItem[]
  salesInvoices   SalesTaxInvoice[]
  deliveryChallans DeliveryChallan[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  srNo           Int
  partNumber     String
  description    String?   @db.NVarChar(MAX)
  manufacturer   String?
  quantity       Int
  unit           String    @default("Pcs")
  zonePriceRmb   Decimal   @default(0.00) @db.Decimal(18, 2)
  profitRatio    Decimal   @default(0.00) @db.Decimal(5, 2)
  unitPrice      Decimal   @db.Decimal(18, 2)
  totalPrice     Decimal   @db.Decimal(18, 2)
  internetPrice  Decimal?  @db.Decimal(18, 2)
  finalUnitPrice Decimal   @db.Decimal(18, 2)
  finalTotalPrice Decimal  @db.Decimal(18, 2)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model SalesTaxInvoice {
  id                 String               @id @default(uuid())
  invoiceNumber      String               @unique
  invoiceDate        DateTime
  quotationId        String?
  quotation          Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  companyName        String
  departmentName     String?
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  ntn                String?
  strn               String?
  poNo               String?
  crNo               String?
  dcNo               String?
  taxRate            Decimal              @default(18.00) @db.Decimal(5, 2)
  taxAmount          Decimal              @db.Decimal(18, 2)
  subTotal           Decimal              @db.Decimal(18, 2)
  totalAmount        Decimal              @db.Decimal(18, 2)
  status             String               @default("PENDING") // PENDING, PAID, PARTIAL, CANCELLED
  remarks            String?              @db.NVarChar(MAX)
  items              SalesTaxInvoiceItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model SalesTaxInvoiceItem {
  id                 String          @id @default(uuid())
  invoiceId          String
  invoice            SalesTaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  srNo               Int
  partNumber         String
  description        String?         @db.NVarChar(MAX)
  manufacturer       String?
  quantity           Int
  unit               String          @default("Pcs")
  unitPrice          Decimal         @db.Decimal(18, 2)
  amountExcludingTax Decimal         @db.Decimal(18, 2)
  taxRate            Decimal         @db.Decimal(5, 2)
  taxAmount          Decimal         @db.Decimal(18, 2)
  amountIncludingTax Decimal         @db.Decimal(18, 2)
}

model DeliveryChallan {
  id               String                @id @default(uuid())
  challanNumber    String                @unique
  dispatchDate     DateTime
  quotationId      String?
  quotation        Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  companyName      String
  departmentName   String?
  contactPerson    String?
  email            String?
  phone            String?
  address          String?
  invoiceReference String?
  vehicleNumber    String?
  driverName       String?
  receiver         String?
  status           String                @default("PENDING") // PENDING, DISPATCHED, DELIVERED, RETURNED
  remarks          String?               @db.NVarChar(MAX)
  items            DeliveryChallanItem[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model DeliveryChallanItem {
  id           String          @id @default(uuid())
  challanId    String
  challan      DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  srNo         Int
  partNumber   String
  description  String?         @db.NVarChar(MAX)
  manufacturer String?
  quantity     Int
  unit         String          @default("Pcs")
  remarks      String?         @db.NVarChar(MAX)
}
